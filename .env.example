# KindSpring environment configuration.
# Copy to .env (never commit .env). REQUIRED = the app will not start without it.
# None of these values may be exposed to the browser – there are no NEXT_PUBLIC_ variables.

# ── Core (REQUIRED) ──
# PostgreSQL. In production use a pooled connection string (e.g. PgBouncer / Neon pooler) with ?connection_limit=…
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kindspring_dev
# Public base URL of this deployment, no trailing slash. Used in emails and payment callbacks.
APP_BASE_URL=http://localhost:3000
# Random secret, at least 32 characters (e.g. `openssl rand -base64 48`). Used for HMACs.
AUTH_SECRET=
# 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Encrypts MFA secrets at rest.
DATA_ENCRYPTION_KEY=

# ── Payments ──
# "sandbox" (no real money, default) or "paystack".
PAYMENT_PROVIDER=sandbox
# REQUIRED when PAYMENT_PROVIDER=sandbox: secret used to sign simulated webhooks.
SANDBOX_WEBHOOK_SECRET=
# REQUIRED when PAYMENT_PROVIDER=paystack. Use sk_test_… until the launch checklist is signed off.
# Paystack signs webhooks with this same secret key (x-paystack-signature, HMAC-SHA512).
PAYSTACK_SECRET_KEY=
# Optional (not currently used by the hosted-checkout integration).
PAYSTACK_PUBLIC_KEY=
# Must be "true" before a live (sk_live_) key is accepted. Requires legal/compliance sign-off.
PAYMENTS_LIVE_MODE_APPROVED=false
# CHARGED_TO_FUND (default) or ABSORBED_BY_PLATFORM – must match the published funding policy.
PROCESSING_FEE_POLICY=CHARGED_TO_FUND
# Disclosed platform fee in basis points (100 = 1%). Default 0 = no platform fee.
PLATFORM_FEE_BPS=0

# ── File storage ──
# "local" (development only, files under LOCAL_STORAGE_DIR) or "s3" (any S3-compatible store).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# REQUIRED when STORAGE_DRIVER=s3:
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_PRIVATE_BUCKET=
OBJECT_STORAGE_PUBLIC_BUCKET=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# "none-dev" (development only – files are marked not scanned) or "external" (files are held
# until a scanner reports CLEAN via /api/webhooks/scan). Production must use "external".
MALWARE_SCAN_MODE=none-dev
# REQUIRED when MALWARE_SCAN_MODE=external.
SCAN_WEBHOOK_SECRET=

# ── Email ──
# "log" (development: logs metadata only) or "resend".
EMAIL_PROVIDER=log
# REQUIRED when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=KindSpring <no-reply@example.org>

# ── Operations ──
# REQUIRED in production: bearer secret for /api/cron/jobs (Vercel Cron sends it automatically).
CRON_SECRET=
# Staff two-step verification for high-risk actions. Defaults to required in production.
STAFF_MFA_REQUIRED=
# Optional: error monitoring DSN (see docs/operations.md).
ERROR_MONITORING_DSN=
